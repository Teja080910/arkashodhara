{
  "name": "@platform/root",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "libs/*",
    "frontend/packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:generate": "npm run db:generate -w @platform/auth -w @platform/api",
    "dev:auth": "npm run dev -w @platform/auth",
    "dev:api": "npm run dev -w @platform/api"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "typescript": "^5.9.3"
  }
}
