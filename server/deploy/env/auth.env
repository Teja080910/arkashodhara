PLATFORM_APP=auth
NODE_ENV=production
PORT=4100
DATABASE_URL=postgres://${POSTGRES_SUPERUSER}:${POSTGRES_SUPERPASSWORD}@postgres:5432/auth
AUTH_SECRET=${AUTH_SECRET}
AUTH_BASE_URL=${AUTH_PUBLIC_URL}
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3010,http://localhost:3010,http://127.0.0.1:3001,http://127.0.0.1:3002,https://arkasodhara.tech,https://drawer.arkasodhara.tech,https://env.arkasodhara.tech,https://folio.arkasodhara.tech,https://portfoli.store,https://www.portfoli.store,https://tracker.arkasodhara.tech,http://localhost:3002,http://localhost:3000,http://localhost:3001,http://localhost:3010,http://localhost:3011,http://localhost:3117,http://localhost:3005,http://127.0.0.1:3005,http://127.0.0.1:3011,http://127.0.0.1:3117
AUTH_RUN_MIGRATIONS=true
DISABLE_JWKS_ENCRYPTION=${DISABLE_JWKS_ENCRYPTION}
INTERNAL_SERVICE_TOKEN=${INTERNAL_SERVICE_TOKEN}
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT}
SMTP_USER=${SMTP_USER}
SMTP_PASS=${SMTP_PASS}
SMTP_FROM=${SMTP_FROM}
