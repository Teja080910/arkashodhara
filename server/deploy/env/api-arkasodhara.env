PLATFORM_APP=api
NODE_ENV=production
PORT=4101
PROJECT=arkasodhara
DATABASE_URL=postgres://${POSTGRES_SUPERUSER}:${POSTGRES_SUPERPASSWORD}@postgres:5432/arkasodhara
AUTH_ISSUER=${AUTH_PUBLIC_URL}
AUTH_JWKS_URL=${AUTH_JWKS_INTERNAL_URL}
AUTH_AUDIENCE=platform
AUTH_JWKS_CACHE_TTL_SECONDS=300
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=arkasodhara-uploads
S3_ACCESS_KEY=${MINIO_ROOT_USER}
S3_SECRET_KEY=${MINIO_ROOT_PASSWORD}
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=900
CORS_ORIGINS=https://arkasodhara.tech,https://www.arkasodhara.tech,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,http://localhost:3010,http://localhost:3011,http://localhost:3117
FEATURE_TEAMS=false
FEATURE_REALTIME=false
FEATURE_PUSH=false
FEATURE_APK_UPLOAD=false
FEATURE_METRICS=true
RUN_MIGRATIONS=true
