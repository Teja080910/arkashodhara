PLATFORM_APP=api
NODE_ENV=production
PORT=4102
PROJECT=drawer
DATABASE_URL=postgres://${POSTGRES_SUPERUSER}:${POSTGRES_SUPERPASSWORD}@postgres:5432/drawer
AUTH_ISSUER=${AUTH_PUBLIC_URL}
AUTH_JWKS_URL=${AUTH_JWKS_INTERNAL_URL}
AUTH_AUDIENCE=platform
AUTH_URL=${AUTH_INTERNAL_URL}
INTERNAL_SERVICE_TOKEN=${INTERNAL_SERVICE_TOKEN}
S3_ENDPOINT=http://minio:9000
S3_PRESIGN_ENDPOINT=${S3_PRESIGN_ENDPOINT}
S3_REGION=us-east-1
S3_BUCKET=${DRAWER_BUCKET}
S3_ACCESS_KEY=${DRAWER_S3_USER}
S3_SECRET_KEY=${DRAWER_S3_PASSWORD}
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=900
S3_PUBLIC_BASE_URL=${FILES_PUBLIC_URL}/${DRAWER_BUCKET}
CORS_ORIGINS=https://drawer.arkasodhara.tech,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,http://localhost:3010,http://localhost:3011,http://localhost:3117
FEATURE_TEAMS=true
FEATURE_REALTIME=false
RUN_MIGRATIONS=true
