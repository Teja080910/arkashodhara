PLATFORM_APP=api
NODE_ENV=production
PORT=4104
PROJECT=portfolio
DATABASE_URL=postgres://${POSTGRES_SUPERUSER}:${POSTGRES_SUPERPASSWORD}@postgres:5432/portfolio
AUTH_ISSUER=${AUTH_PUBLIC_URL}
AUTH_JWKS_URL=${AUTH_JWKS_INTERNAL_URL}
AUTH_AUDIENCE=platform
S3_ENDPOINT=http://minio:9000
S3_PRESIGN_ENDPOINT=${S3_PRESIGN_ENDPOINT}
S3_REGION=us-east-1
S3_BUCKET=${PORTFOLIO_BUCKET}
S3_ACCESS_KEY=${PORTFOLIO_S3_USER}
S3_SECRET_KEY=${PORTFOLIO_S3_PASSWORD}
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=900
S3_PUBLIC_BASE_URL=https://files.arkasodhara.tech/${PORTFOLIO_BUCKET}
CORS_ORIGINS=https://folio.arkasodhara.tech,https://portfoli.store,https://www.portfoli.store,http://localhost:3010,http://127.0.0.1:3010,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3011,http://127.0.0.1:3011,http://localhost:3117,http://127.0.0.1:3117
FEATURE_TEAMS=true
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT}
SMTP_USER=${SMTP_USER}
SMTP_PASS=${SMTP_PASS}
SMTP_FROM=${SMTP_FROM}
RUN_MIGRATIONS=true
