PLATFORM_APP=api
NODE_ENV=production
PORT=4105
PROJECT=project-tracker
DATABASE_URL=postgres://${POSTGRES_SUPERUSER}:${POSTGRES_SUPERPASSWORD}@postgres:5432/project-tracker
AUTH_ISSUER=${AUTH_PUBLIC_URL}
AUTH_JWKS_URL=${AUTH_JWKS_INTERNAL_URL}
AUTH_AUDIENCE=platform
AUTH_URL=${AUTH_INTERNAL_URL}
INTERNAL_SERVICE_TOKEN=${INTERNAL_SERVICE_TOKEN}
S3_ENDPOINT=http://minio:9000
S3_PRESIGN_ENDPOINT=${S3_PRESIGN_ENDPOINT}
S3_REGION=us-east-1
S3_BUCKET=${PT_TASK_SCREENSHOTS_BUCKET}
S3_ACCESS_KEY=${PT_S3_USER}
S3_SECRET_KEY=${PT_S3_PASSWORD}
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=900
S3_PUBLIC_BASE_URL=https://files.arkasodhara.tech/${PT_TASK_SCREENSHOTS_BUCKET}
CORS_ORIGINS=https://tracker.arkasodhara.tech,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,http://localhost:3010,http://localhost:3011,http://localhost:3117,http://localhost:3005,http://127.0.0.1:3005,http://127.0.0.1:3010
FEATURE_TEAMS=true
FEATURE_REALTIME=true
FEATURE_PUSH=true
FEATURE_APK_UPLOAD=true
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT}
SMTP_USER=${SMTP_USER}
SMTP_PASS=${SMTP_PASS}
SMTP_FROM=${SMTP_FROM}
VAPID_PUBLIC_KEY=${VAPID_PUBLIC_KEY}
VAPID_PRIVATE_KEY=${VAPID_PRIVATE_KEY}
VAPID_SUBJECT=${VAPID_SUBJECT}
RUN_MIGRATIONS=true
