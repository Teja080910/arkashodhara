# syntax=docker/dockerfile:1.7
# Generic Next.js standalone image for the platform frontends.
# Build with the app directory as context:
#   docker build -f platform/deploy/Dockerfile.frontend --build-arg APP=drawer \
#     --build-arg NEXT_PUBLIC_API_URL=... ./drawer
ARG NODE_IMAGE=node:24-alpine

FROM ${NODE_IMAGE} AS deps
WORKDIR /app
COPY package.json package-lock.json* .npmrc* ./
RUN if [ -f package-lock.json ]; then npm ci --no-audit --no-fund; else npm install --no-audit --no-fund; fi

FROM ${NODE_IMAGE} AS builder
WORKDIR /app
ARG NEXT_PUBLIC_API_URL=""
ARG NEXT_PUBLIC_AUTH_URL=""
ARG NEXT_PUBLIC_FILES_URL=""
ARG NEXT_PUBLIC_WS_URL=""
ARG NEXT_PUBLIC_SITE_URL=""
ARG NEXT_PUBLIC_APP_URL=""
ARG NEXT_PUBLIC_APP_NAME=""
ARG NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_AUTH_URL=$NEXT_PUBLIC_AUTH_URL \
    NEXT_PUBLIC_FILES_URL=$NEXT_PUBLIC_FILES_URL \
    NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL \
    NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME \
    NEXT_PUBLIC_VAPID_PUBLIC_KEY=$NEXT_PUBLIC_VAPID_PUBLIC_KEY \
    NEXT_TELEMETRY_DISABLED=1 \
    APP_SECRET=build-placeholder-not-used-at-runtime
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build
# Keep the dependency tree for non-standalone (Next 13) apps, and guarantee
# that .next/standalone exists so the runner stage can always copy it.
RUN cp -a /app/node_modules /app/node_modules.keep && mkdir -p /app/.next/standalone

FROM ${NODE_IMAGE} AS runner
WORKDIR /app
ARG APP=app
ARG STANDALONE=true
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    DATA_DIR=/data
RUN addgroup -S -g 1001 nodejs \
  && adduser -S -u 1001 -G nodejs nextjs \
  && mkdir -p /data && chown nextjs:nodejs /data
COPY --from=builder --chown=nextjs:nodejs /app/.next ./.next
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./package.json
COPY --from=builder --chown=nextjs:nodejs /app/node_modules.keep ./node_modules.keep
RUN if [ "$STANDALONE" = "true" ]; then \
      cp -a /app/.next/standalone/. /app/; \
      rm -rf /app/node_modules.keep /app/.next/standalone; \
    else \
      mv /app/node_modules.keep /app/node_modules; \
    fi
USER nextjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"
CMD ["sh", "-c", "if [ -f server.js ]; then exec node server.js; else exec node node_modules/next/dist/bin/next start -p 3000; fi"]
