    "start": "node dist/main.js",
    "auth:migrate": "better-auth migrate --config src/auth.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@platform/common": "0.1.0",
    "better-auth": "^1.7.19",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12",
    "nodemailer": "^7.0.9"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "@types/nodemailer": "^7.0.2"
  }
