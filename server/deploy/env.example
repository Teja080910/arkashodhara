# Shared secrets for the whole stack. Copy to deploy/.env and fill in.
POSTGRES_SUPERUSER=platform
POSTGRES_SUPERPASSWORD=change-me

MINIO_ROOT_USER=platform-root
MINIO_ROOT_PASSWORD=change-me-change-me

INTERNAL_SERVICE_TOKEN=change-me-internal-token

AUTH_SECRET=change-me-at-least-32-characters-long

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Buckets + per-project MinIO identity (also used by minio-init)
DRAWER_BUCKET=drawer-flow-images
DRAWER_S3_USER=drawer-app
DRAWER_S3_PASSWORD=change-me-drawer
PORTFOLIO_BUCKET=portfolio-profile-photos
PORTFOLIO_S3_USER=portfolio-app
PORTFOLIO_S3_PASSWORD=change-me-portfolio
PT_TASK_SCREENSHOTS_BUCKET=pt-task-screenshots
PT_AVATARS_BUCKET=pt-avatars
PT_DOCS_BUCKET=pt-docs
PT_APKS_BUCKET=pt-apks
PT_S3_USER=pt-app
PT_S3_PASSWORD=change-me-pt

# Public URL of the auth service; for local compose use http://auth:4100
AUTH_PUBLIC_URL=https://auth.arkasodhara.tech
AUTH_JWKS_PUBLIC_URL=https://auth.arkasodhara.tech/api/auth/.well-known/jwks.json

# Public endpoint used only for signing URLs (must be reachable by browsers)
S3_PRESIGN_ENDPOINT=https://files.arkasodhara.tech
# Frontend public URLs (browser-reachable)
WEB_AUTH_URL=http://localhost:4100
WEB_API_URL=http://localhost:4102
WEB_API_URL_PORTFOLIO=http://localhost:4104
WEB_API_URL_PT=http://localhost:4105
WEB_WS_URL=ws://localhost:4105/ws
WEB_SITE_URL_PORTFOLIO=http://localhost:3010
WEB_SITE_URL_PT=http://localhost:3005
DRAWER_FILES_URL=http://localhost:19000/drawer-flow-images
PORTFOLIO_FILES_URL=http://localhost:19000/portfolio-profile-photos
PT_FILES_URL=http://localhost:19000/pt-task-screenshots
ADMIN_EMAILS=tejasimma36@gmail.com,tejasimma033@gmail.com
ADMIN_SERVERS="local|This server|local"
